# Standalone (docker compose) configuration. Under Home Assistant these come
# from the add-on Configuration tab instead and this file is not used.
FAVOURITE_TEAM=ajax
COMPETITIONS=eredivisie,kkd,knvb_beker,johan_cruijff_schaal,oranje
LANGUAGE=nl
LOG_LEVEL=info
# Replay a scripted matchday instead of calling the live providers.
DEMO_MODE=
